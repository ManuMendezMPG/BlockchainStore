# /bridge/.env.example
# Copia este fichero a `.env` si lo necesitas. `.env` está en .gitignore.
#
# Estado actual: el servidor (server.js) SÍ usa dependencias npm (siwe + ethers,
# para el login SIWE → hace falta `npm install`), pero NO carga un fichero .env;
# lee variables de entorno directamente: PORT y RPC_URL. La dirección del contrato
# y el chain id viven de momento como CONSTANTES en public/app.js (código de
# FRONTEND, se ejecuta en el navegador).
#
# Este fichero documenta qué variables harían falta si más adelante movemos esa
# configuración al backend o inyectamos config al frontend desde el servidor.

# Puerto del servidor estático local.
PORT=8787

# URL del nodo RPC (Anvil local). La USA el backend (server.js) para el provider
# de solo lectura de las lecturas /api/*; por defecto http://127.0.0.1:8545.
RPC_URL=http://127.0.0.1:8545

# Dirección del contrato GameStore desplegado. Hoy está en app.js como
# CONTRACT_ADDRESS. En Anvil es determinista (primer deploy de la cuenta #0).
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Chain ID esperado; el front avisa si MetaMask está en otra red. 31337 = Anvil.
CHAIN_ID=31337
